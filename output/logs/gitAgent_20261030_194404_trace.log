    "content": "FROM node:16\n\nWORKDIR /app\n\nCOPY package*.json ./\n\nRUN npm install --no-audit --no-fund\n\nCOPY . .\n\nEXPOSE 8080\n\nCMD [\"npm\", \"run\", \"dev\", \"--\", \"--host\", \"0.0.0.0\"]\n"
  }
}
```

